---
import SearchIcon from 'reicon/icons/Search';
const { name, class: className = '' } = Astro.props;
const paths: Record<string,string> = {
 search:'<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>',
 arrow:'<path d="m9 18 6-6-6-6"/>', external:'<path d="M14 5h5v5M19 5l-8 8"/><path d="M18 13v5H6V6h5"/>',
 book:'<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5z"/>',
 menu:'<path d="M4 7h16M4 12h16M4 17h16"/>', close:'<path d="m6 6 12 12M18 6 6 18"/>'
};
const reiconSearch = name === 'search' ? SearchIcon.toSvg({ size: 24, color: 'currentColor', weight: 'Outline' }) : '';
---
{reiconSearch ? <span class={className} aria-hidden="true" set:html={reiconSearch}/> : <svg class={className} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={paths[name] ?? paths.book}/>}
