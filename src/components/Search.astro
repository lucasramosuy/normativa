---
import Icon from './Icon.astro';
const { value='', action=`${import.meta.env.BASE_URL}buscar/`, label='Buscar normativa', norma='', placeholder='Buscá por norma, tema o número de artículo', compact=false }=Astro.props;
---
<form class:list={["search-control",compact&&"search-compact"]} action={action} role="search">{norma&&<input type="hidden" name="norma" value={norma}/>}<Icon name="search" class="size-5 shrink-0 text-forest"/><label class="sr-only" for="global-search">{label}</label><input id="global-search" name="q" type="search" value={value} placeholder={placeholder} autocomplete="off"/><kbd class:list={["hidden rounded-md border border-black/10 bg-ivory px-2 py-1 text-xs text-slate-500",!compact&&"sm:block"]}>/</kbd><button class="rounded-lg bg-forest px-4 py-2 text-sm font-bold text-white">Buscar</button></form>
<script is:inline>(()=>{let warmed=false;const warm=()=>{if(warmed||location.pathname.endsWith('/buscar/'))return;warmed=true;const b=document.querySelector('link[rel=icon]')?.getAttribute('href')?.replace(/favicon\.svg$/,'')||'/';import(b+'pagefind/pagefind.js').then(p=>p.init&&p.init()).catch(()=>{});};document.addEventListener('focusin',e=>{if(e.target&&e.target.id==='global-search')warm();});document.addEventListener('pointerover',e=>{if(e.target&&e.target.closest&&e.target.closest('.search-control'))warm();},{passive:true});})();document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement?.tagName)){e.preventDefault();document.querySelector('#global-search')?.focus()}})</script>
