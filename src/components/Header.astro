---
import BankIcon from 'reicon/icons/Bank';
const logoSvg = BankIcon.toSvg({ size: 22, color: 'currentColor', weight: 'Bold' });
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL;
---
<header class="sticky top-0 z-40 border-b border-black/10 bg-[#fbfaf7]/95 backdrop-blur">
 <div class="wrap flex h-[var(--header-h)] items-center justify-between">
  <a href={base} class="flex items-center gap-2.5 no-underline" aria-label="Normativa Uruguay, inicio"><span class="grid size-9 place-items-center rounded-[10px] bg-forest text-white" aria-hidden="true" set:html={logoSvg}></span><span><b class="block font-serif text-lg leading-none">Normativa</b><small class="mt-1 block text-[.58rem] uppercase tracking-[.18em] text-slate-500">Uruguay</small></span></a>
  <nav class="hidden items-center gap-7 text-sm font-semibold md:flex" aria-label="Principal"><a href={`${base}explorar/`}>Explorar</a><a href={`${base}acerca-de/`}>Acerca del proyecto</a><a href={`${base}fuentes-y-metodologia/`}>Fuentes</a></nav>
  <button id="menu-button" class="grid size-11 place-items-center rounded-full border border-black/15 md:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir menú"><Icon name="menu" class="size-5"/></button>
 </div>
 <nav id="mobile-nav" hidden class="wrap border-t border-black/10 py-3 text-sm font-semibold md:hidden"><a class="block py-3" href={`${base}explorar/`}>Explorar</a><a class="block py-3" href={`${base}acerca-de/`}>Acerca del proyecto</a><a class="block py-3" href={`${base}fuentes-y-metodologia/`}>Fuentes</a></nav>
</header>
<script is:inline>
 const btn=document.querySelector('#menu-button'),nav=document.querySelector('#mobile-nav');btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));nav.hidden=open});
</script>
