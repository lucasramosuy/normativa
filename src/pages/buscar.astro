---
import Base from '../layouts/Base.astro';import Search from '../components/Search.astro';import {articles,normalize} from '../data/normas';
const base=import.meta.env.BASE_URL;
const items=articles.map(a=>({a,s:normalize([a.articulo,a.texto,a.seccion,a.capitulo,a.notas_oficiales].join(' '))}));
---
<Base title="Buscar · Normativa Uruguay"><main class="wrap py-12"><Search/><div class="mt-12 grid gap-9 lg:grid-cols-[220px_1fr]"><aside><b>Filtrar resultados</b><p class="eyebrow mt-8">Tipo de norma</p><div class="mt-3 rounded-lg bg-mint px-3 py-2 text-sm font-bold text-forest">Constitución <span class="float-right" data-count>{articles.length}</span></div></aside><section><p class="eyebrow"><span data-count>{articles.length}</span> resultados</p><h1 class="mt-2 text-5xl" data-heading>Todos los artículos</h1><div class="mt-7 space-y-3" data-results>{items.map(({a,s})=><a class="soft-card block p-6 transition hover:border-forest" data-s={s} data-n={String(a.articulo)} href={`${base}normas/constitucion/articulo/${a.articulo}/`}><div class="flex gap-3 text-xs"><span class="chip">Constitución</span><span class="py-1.5 text-slate-500">Artículo {a.articulo}</span></div><p class="mt-4 line-clamp-3 font-semibold leading-7">{a.texto}</p><small class="mt-3 block text-slate-500">{a.seccion}</small></a>)}</div><div class="soft-card mt-8 hidden p-10 text-center" data-empty><h2 class="text-2xl">No encontramos resultados</h2><p class="mt-3 text-slate-600">Probá con menos palabras, otra forma de escribir o un número de artículo.</p></div></section></div></main></Base>
<script>
const norm=(v:string)=>v.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const q=(new URLSearchParams(location.search).get('q')||'').trim();
const input=document.querySelector<HTMLInputElement>('input[name="q"]');if(input)input.value=q;
if(q){
  const f=norm(q.replace(/^art(i|í)culo\s+/i,''));const num=/^\d+$/.test(f);
  let n=0;document.querySelectorAll<HTMLElement>('[data-results] > a').forEach(el=>{const ok=num?el.dataset.n===f||(el.dataset.s||'').includes(f):(el.dataset.s||'').includes(f);el.hidden=!ok;if(ok)n++;});
  document.querySelectorAll('[data-count]').forEach(e=>e.textContent=String(n));
  const h=document.querySelector('[data-heading]');if(h)h.textContent=`“${q}”`;
  document.title=`“${q}” · Normativa Uruguay`;
  document.querySelector('[data-empty]')?.classList.toggle('hidden',n>0);
}
</script>
