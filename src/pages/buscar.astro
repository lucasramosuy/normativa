---
import Base from '../layouts/Base.astro';import Search from '../components/Search.astro';import {articles,normalize} from '../data/normas';
const q=Astro.url.searchParams.get('q')?.trim()??'';const folded=normalize(q.replace(/^art(i|í)culo\s+/i,''));const results=folded?articles.filter(a=>normalize([a.articulo,a.texto,a.seccion,a.capitulo,a.notas_oficiales].join(' ')).includes(folded)):articles;const base=import.meta.env.BASE_URL;
---
<Base title={`${q?`“${q}”`:'Buscar'} · Normativa Uruguay`}><main class="wrap py-12"><Search value={q}/><div class="mt-12 grid gap-9 lg:grid-cols-[220px_1fr]"><aside><b>Filtrar resultados</b><p class="eyebrow mt-8">Tipo de norma</p><div class="mt-3 rounded-lg bg-mint px-3 py-2 text-sm font-bold text-forest">Constitución <span class="float-right">{results.length}</span></div></aside><section><p class="eyebrow">{results.length} resultados</p><h1 class="mt-2 text-5xl">{q?`“${q}”`:'Todos los artículos'}</h1><div class="mt-7 space-y-3">{results.slice(0,80).map(a=><a class="soft-card block p-6 transition hover:border-forest" href={`${base}normas/constitucion/articulo/${a.articulo}/`}><div class="flex gap-3 text-xs"><span class="chip">Constitución</span><span class="py-1.5 text-slate-500">Artículo {a.articulo}</span></div><p class="mt-4 line-clamp-3 font-semibold leading-7">{a.texto}</p><small class="mt-3 block text-slate-500">{a.seccion}</small></a>)}</div>{results.length===0&&<div class="soft-card mt-8 p-10 text-center"><h2 class="text-2xl">No encontramos resultados</h2><p class="mt-3 text-slate-600">Probá con menos palabras, otra forma de escribir o un número de artículo.</p></div>}</section></div></main></Base>
