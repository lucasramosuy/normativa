---
import Base from '../layouts/Base.astro';import Search from '../components/Search.astro';import Icon from '../components/Icon.astro';import {NORMAS,getArticles,totalArticles,fmt} from '../data/normas';
const base=import.meta.env.BASE_URL;const total=fmt(totalArticles());
---
<Base title="Normativa Uruguay · Buscador jurídico"><main><section class="overflow-hidden border-b border-black/5 bg-[linear-gradient(120deg,#fbfaf7_64%,#f0ece3)]"><div class="wrap grid min-h-[590px] grid-cols-1 items-center gap-10 py-16 md:grid-cols-[1.1fr_.9fr]"><div class="min-w-0"><p class="eyebrow">Derecho uruguayo, en claro</p><h1 data-tinta-title class="tinta-title mt-4 text-5xl leading-[.95] font-semibold tracking-[-.035em] md:text-7xl">Encontrá la norma.<br/><em class="font-normal text-forest">Entendé el contexto.</em></h1><p class="mt-7 max-w-xl text-lg leading-8 text-slate-600">Buscá entre {total} artículos de la Constitución, los códigos y las principales leyes y decretos en un solo lugar. Siempre con acceso directo a la fuente oficial.</p><div class="mt-8"><Search/></div><div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500"><span class="mr-2 py-1.5">Búsquedas frecuentes</span><a class="rounded-full border px-3 py-1.5" href={`${base}buscar/?q=libertad`}>libertad</a><a class="rounded-full border px-3 py-1.5" href={`${base}buscar/?q=legítima%20defensa`}>legítima defensa</a><a class="rounded-full border px-3 py-1.5" href={`${base}buscar/?q=divorcio`}>divorcio</a><a class="rounded-full border px-3 py-1.5" href={`${base}normas/constitucion/articulo/7/`}>Artículo 7</a></div></div><div class="relative mx-auto h-[360px] w-full max-w-[430px]" aria-hidden="true"><div class="absolute right-3 top-0 size-56 rounded-full bg-ceibo/75"></div><div class="absolute bottom-0 right-0 h-72 w-72 rounded-t-full bg-forest"><div class="absolute inset-x-8 bottom-0 flex h-32 gap-5"><i class="flex-1 rounded-t-full bg-ivory"></i><i class="flex-1 rounded-t-full bg-ivory"></i><i class="flex-1 rounded-t-full bg-ivory"></i></div></div><div class="absolute left-0 top-14 h-56 w-44 -rotate-6 bg-white p-7 shadow-2xl"><b class="font-serif text-4xl text-forest">Art. 7</b><i class="mt-8 block h-1.5 bg-slate-200"></i><i class="mt-3 block h-1.5 bg-slate-200"></i><i class="mt-3 block h-1.5 bg-slate-200"></i></div></div></div></section><section class="wrap pt-9 md:pt-14" aria-labelledby="leydle-heading"><div class="leydle-band"><div class="leydle-copy"><p class="eyebrow">Una pausa para pensar</p><h2 id="leydle-heading">El derecho también se juega.</h2><p>Conocé <strong>Leydle</strong>: cinco letras, un poquito de derecho. Una palabra nueva cada día.</p><a href={`${base}leydle/`}>Jugar a Leydle <span aria-hidden="true">→</span></a></div><div class="leydle-art" aria-hidden="true"><div class="leydle-tiles"><span>L</span><span>E</span><span>Y</span><span></span><span></span></div><small>5 LETRAS · UN DESAFÍO DIARIO</small></div></div></section><section class="wrap py-20"><div class="flex items-end justify-between"><div><p class="eyebrow">Colección</p><h2 class="mt-2 text-4xl">Explorá la normativa</h2></div><a class="font-bold text-forest" href={`${base}explorar/`}>Ver las {NORMAS.length} normas →</a></div><div class="mt-8 grid gap-4 md:grid-cols-3">{NORMAS.slice(0,6).map((n,i)=><a class={`soft-card p-7 transition hover:border-forest ${i===0?"bg-mint/60":""}`} href={`${base}normas/${n.slug}/`}><span class="chip">{n.tipo}</span><h3 class="mt-10 text-3xl">{n.corto}</h3><p class="mt-3 text-slate-600">{n.descripcion}</p><b class="mt-6 block text-sm text-forest">{fmt(getArticles(n.slug).length)} artículos →</b></a>)}</div><a class="group mt-14 flex items-center justify-between gap-6 rounded-2xl bg-ink p-8 text-white transition hover:bg-[#23302b] focus-visible:bg-[#23302b]" href={`${base}fuentes-y-metodologia/`}><div><h3 class="text-2xl">Fuente oficial primero.</h3><p class="mt-2 text-sm text-slate-300">Cada artículo enlaza directamente a IMPO. <span class="font-semibold text-mint underline-offset-4 group-hover:underline group-focus-visible:underline">Ver fuentes y metodología</span></p></div><Icon name="arrow" class="size-8 shrink-0 text-mint transition group-hover:translate-x-1 group-focus-visible:translate-x-1"/></a></section></main></Base>


<style>
.leydle-band{background:#edf3ee;border:1px solid #dce8df;padding:34px 38px;display:grid;grid-template-columns:1fr auto;align-items:center;gap:30px}
.leydle-copy .eyebrow{color:#176b63}
.leydle-copy h2{font-family:Georgia,serif;font-weight:700;font-size:clamp(26px,3vw,36px);letter-spacing:-.025em;line-height:1.07;margin:10px 0 13px;color:#202b26}
.leydle-copy p:not(.eyebrow){color:#52635b;font-size:16px;line-height:1.55;max-width:440px}
.leydle-copy strong{color:#202b26}
.leydle-copy a{display:inline-flex;gap:10px;align-items:center;font-size:15px;color:#176b63;font-weight:700;border-bottom:1px solid #176b63;text-decoration:none;padding-bottom:2px;margin-top:19px}
.leydle-copy a:hover,.leydle-copy a:focus-visible{color:#114e49;border-bottom-width:2px}
.leydle-art{text-align:center;padding:8px}
.leydle-tiles{display:flex;gap:5px}
.leydle-tiles span{width:48px;height:52px;display:grid;place-items:center;border:1px solid #b9cdc1;background:#fbfaf7;color:#176b63;font-family:Georgia,serif;font-size:25px;font-weight:700}
.leydle-tiles span:first-child{color:#fff;background:#176b63;border-color:#176b63}
.leydle-tiles span:nth-child(2){background:#c2d4c6}
.leydle-art small{display:block;font-size:11px;font-weight:700;letter-spacing:.11em;color:#63776b;margin-top:15px}
@media(max-width:640px){.leydle-band{padding:26px 22px;display:block}.leydle-copy h2{font-size:28px}.leydle-copy p:not(.eyebrow){font-size:15px}.leydle-copy a{margin-top:16px}.leydle-art{padding:24px 0 0;text-align:left}.leydle-tiles span{width:44px;height:45px;font-size:22px}.leydle-art small{margin-top:10px}}
</style>

<style is:global>
@media (hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference){
  .tinta-title{color:rgba(23,33,29,.56)}
  .tinta-title em{color:rgba(23,107,99,.56)}
}
.tinta-canvas{position:fixed;inset:0;width:100vw;height:100vh;z-index:30;pointer-events:none}
.tinta-reveal{position:fixed;z-index:31;pointer-events:none;margin:0;clip-path:circle(0 at 0 0)}
@media (any-pointer:coarse),(prefers-reduced-motion:reduce){.tinta-canvas,.tinta-reveal{display:none}}
</style>
<script>
const motion=window.matchMedia('(prefers-reduced-motion: reduce)');
const coarse=window.matchMedia('(any-pointer: coarse)');
const fine=window.matchMedia('(any-pointer: fine)');
let stopTinta=()=>{};
const query='(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference)';
function configureTinta(){
  stopTinta();stopTinta=()=>{};
  if(motion.matches||coarse.matches||!fine.matches||!window.matchMedia(query).matches)return;
  const target=document.querySelector('[data-tinta-title]');
  if(!target)return;
  const canvas=document.createElement('canvas');
  canvas.className='tinta-canvas';canvas.setAttribute('aria-hidden','true');
  const ctx=canvas.getContext('2d');if(!ctx)return;
  const reveal=target.cloneNode(true);
  reveal.removeAttribute('data-tinta-title');
  reveal.className=target.className.replace(/\btinta-title\b/g,'')+' tinta-reveal';
  reveal.setAttribute('aria-hidden','true');
  document.body.append(canvas,reveal);
  let width=0,height=0,dpr=1,frame=0,alive=true,stamps=[];
  function size(){
    width=window.innerWidth;height=window.innerHeight;dpr=window.devicePixelRatio||1;
    if(!width||!height){canvas.width=canvas.height=0;return false}
    canvas.width=Math.ceil(width*dpr);canvas.height=Math.ceil(height*dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);
    return canvas.width>0&&canvas.height>0;
  }
  function place(){
    const rect=target.getBoundingClientRect();
    reveal.style.left=rect.left+'px';reveal.style.top=rect.top+'px';
    reveal.style.width=rect.width+'px';reveal.style.height=rect.height+'px';
  }
  function paint(now){
    frame=0;
    if(!alive||!canvas.width||!canvas.height)return;
    ctx.clearRect(0,0,width,height);
    stamps=stamps.filter(s=>now-s.time<900);
    for(const stamp of stamps){
      const progress=(now-stamp.time)/900;
      const radius=18+progress*22;
      ctx.beginPath();ctx.arc(stamp.x,stamp.y,radius,0,Math.PI*2);
      ctx.strokeStyle=`rgba(23,107,99,${(1-progress)*.13})`;ctx.lineWidth=1;ctx.stroke();
    }
    if(stamps.length)frame=requestAnimationFrame(paint);
  }
  function wake(){if(!frame&&alive)frame=requestAnimationFrame(paint)}
  function move(event){
    if(event.pointerType!=='mouse')return;
    const x=event.clientX,y=event.clientY;
    if(x<0||y<0||x>=width||y>=height){reveal.style.clipPath='circle(0 at 0 0)';return}
    const rect=target.getBoundingClientRect();
    if(x<rect.left-110||x>rect.right+110||y<rect.top-110||y>rect.bottom+110){reveal.style.clipPath='circle(0 at 0 0)';return}
    place();
    reveal.style.clipPath=`circle(76px at ${x-rect.left}px ${y-rect.top}px)`;
    stamps.push({x,y,time:performance.now()});if(stamps.length>10)stamps.shift();wake();
  }
  function redraw(){
    if(!size())return;
    place();stamps=[];cancelAnimationFrame(frame);frame=0;
    ctx.clearRect(0,0,width,height);reveal.style.clipPath='circle(0 at 0 0)';
  }
  window.addEventListener('pointermove',move,{passive:true});
  window.addEventListener('resize',redraw,{passive:true});
  window.addEventListener('scroll',redraw,{passive:true});
  redraw();
  stopTinta=()=>{alive=false;cancelAnimationFrame(frame);window.removeEventListener('pointermove',move);window.removeEventListener('resize',redraw);window.removeEventListener('scroll',redraw);canvas.remove();reveal.remove()};
}
for(const media of [motion,coarse,fine,window.matchMedia(query)])media.addEventListener('change',configureTinta);
configureTinta();
</script>
