---
import Base from '../layouts/Base.astro';import Search from '../components/Search.astro';import Icon from '../components/Icon.astro';import {NORMAS,getArticles,totalArticles,fmt} from '../data/normas';
const base=import.meta.env.BASE_URL;const total=fmt(totalArticles());
---
<Base title="Normativa Uruguay · Buscador jurídico"><main><section class="overflow-hidden border-b border-black/5 bg-[linear-gradient(120deg,#fbfaf7_64%,#f0ece3)]"><div class="wrap grid min-h-[590px] items-center gap-10 py-16 md:grid-cols-[1.1fr_.9fr]"><div><p class="eyebrow">Derecho uruguayo, en claro</p><h1 class="mt-4 text-5xl leading-[.95] font-semibold tracking-[-.035em] md:text-7xl">Encontrá la norma.<br/><em class="font-normal text-forest">Entendé el contexto.</em></h1><p class="mt-7 max-w-xl text-lg leading-8 text-slate-600">Buscá entre {total} artículos de la Constitución y seis códigos en un solo lugar. Siempre con acceso directo a la fuente oficial.</p><div class="mt-8"><Search/></div><div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500"><span class="mr-2 py-1.5">Búsquedas frecuentes</span><a class="rounded-full border px-3 py-1.5" href={`${base}buscar/?q=libertad`}>libertad</a><a class="rounded-full border px-3 py-1.5" href={`${base}buscar/?q=legítima%20defensa`}>legítima defensa</a><a class="rounded-full border px-3 py-1.5" href={`${base}buscar/?q=divorcio`}>divorcio</a><a class="rounded-full border px-3 py-1.5" href={`${base}normas/constitucion/articulo/7/`}>Artículo 7</a></div></div><div class="relative mx-auto h-[360px] w-full max-w-[430px]" aria-hidden="true"><div class="absolute right-3 top-0 size-56 rounded-full bg-ceibo/75"></div><div class="absolute bottom-0 right-0 h-72 w-72 rounded-t-full bg-forest"><div class="absolute inset-x-8 bottom-0 flex h-32 gap-5"><i class="flex-1 rounded-t-full bg-ivory"></i><i class="flex-1 rounded-t-full bg-ivory"></i><i class="flex-1 rounded-t-full bg-ivory"></i></div></div><div class="absolute left-0 top-14 h-56 w-44 -rotate-6 bg-white p-7 shadow-2xl"><b class="font-serif text-4xl text-forest">Art. 7</b><i class="mt-8 block h-1.5 bg-slate-200"></i><i class="mt-3 block h-1.5 bg-slate-200"></i><i class="mt-3 block h-1.5 bg-slate-200"></i></div></div></div></section><section class="wrap py-20"><div class="flex items-end justify-between"><div><p class="eyebrow">Colección</p><h2 class="mt-2 text-4xl">Explorá la normativa</h2></div><a class="font-bold text-forest" href={`${base}explorar/`}>Ver las 7 normas →</a></div><div class="mt-8 grid gap-4 md:grid-cols-3">{NORMAS.slice(0,6).map((n,i)=><a class={`soft-card p-7 transition hover:border-forest ${i===0?"bg-mint/60":""}`} href={`${base}normas/${n.slug}/`}><span class="chip">{n.tipo}</span><h3 class="mt-10 text-3xl">{n.corto}</h3><p class="mt-3 text-slate-600">{n.descripcion}</p><b class="mt-6 block text-sm text-forest">{fmt(getArticles(n.slug).length)} artículos →</b></a>)}</div><div class="mt-14 flex items-center justify-between rounded-2xl bg-ink p-8 text-white"><div><h3 class="text-2xl">Fuente oficial primero.</h3><p class="mt-2 text-sm text-slate-300">Cada resultado enlaza directamente a IMPO.</p></div><Icon name="external" class="size-8 text-mint"/></div></section></main></Base>
