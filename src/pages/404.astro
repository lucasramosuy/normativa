---
import Base from '../layouts/Base.astro';import Search from '../components/Search.astro';const base=import.meta.env.BASE_URL;
---
<Base title="Página no encontrada · Normativa Uruguay"><main class="wrap py-16 text-center"><div class="relative mx-auto h-60 max-w-md" aria-hidden="true"><div class="absolute left-1/2 top-4 size-40 -translate-x-1/2 rounded-full bg-ceibo/75"></div><div class="absolute left-1/2 top-12 flex h-36 w-60 -translate-x-1/2 -rotate-3 items-center justify-center gap-4 bg-white font-serif text-6xl font-bold text-forest shadow-xl"><span>4</span><span class="text-[#b95e48]">0</span><span>4</span></div><div class="absolute bottom-1 right-6 size-20 rounded-full border-[9px] border-ink bg-mint after:absolute after:-bottom-7 after:-right-5 after:h-10 after:w-2.5 after:rotate-[-45deg] after:rounded-full after:bg-ink"></div></div><p class="eyebrow">Error 404</p><h1 class="mx-auto mt-4 max-w-2xl text-5xl leading-tight">Esta norma se nos perdió entre los expedientes.</h1><p class="mx-auto mt-5 max-w-xl text-slate-600">La página que buscás no existe o cambió de dirección. Probá con el buscador o volvé al inicio.</p><div class="mx-auto mt-8 max-w-2xl text-left"><Search/></div><a class="mt-7 inline-block rounded-lg bg-forest px-5 py-3 font-bold text-white" href={base}>Volver al inicio</a></main></Base>
