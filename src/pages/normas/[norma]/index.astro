---
import Base from '../../../layouts/Base.astro';import Search from '../../../components/Search.astro';
import {NORMAS,getArticles,getNorma,idOf,labelOf,headingsOf,slugify,fmt} from '../../../data/normas';
export function getStaticPaths(){return NORMAS.map(n=>({params:{norma:n.slug}}))}
const {norma:slug}=Astro.params;const norma=getNorma(slug!);const list=getArticles(slug!);const base=import.meta.env.BASE_URL;
// Group consecutive articles by their full heading path; TOC uses the top level.
type Group={key:string;path:string[];items:typeof list};
const groups:Group[]=[];for(const a of list){const p=headingsOf(a);const k=p.join(' › ');const last=groups[groups.length-1];if(last&&last.key===k)last.items.push(a);else groups.push({key:k,path:p,items:[a]});}
const tops:{label:string;id:string;count:number}[]=[];for(const g of groups){const top=g.path[0]??'Disposiciones';const id=slugify(top);const t=tops.find(x=>x.id===id);if(t)t.count+=g.items.length;else tops.push({label:top,id,count:g.items.length});}
const seen=new Set<string>();
const snippet=(s:string)=>s.length>150?s.slice(0,150).replace(/\s+\S*$/,'')+'…':s;
---
<Base title={`${norma.nombre} · Normativa Uruguay`} description={`${norma.nombre}: ${fmt(list.length)} artículos con enlace a la fuente oficial en IMPO.`}><main class="wrap py-12"><nav class="text-sm text-slate-500"><a href={base}>Inicio</a> › <a href={`${base}explorar/`}>Explorar</a> › {norma.corto}</nav><p class="eyebrow mt-8">{norma.tipo} · Fuente IMPO</p><h1 class="mt-3 max-w-4xl text-5xl leading-none md:text-6xl">{norma.nombre}</h1><p class="mt-5 max-w-3xl text-lg text-slate-600">{norma.descripcion} {fmt(list.length)} artículos.</p><div class="mt-8"><Search norma={slug} label={`Buscar en ${norma.corto}`} placeholder={`Buscar en ${norma.corto}: tema o número de artículo`}/></div>
<div class="mt-12 grid gap-10 lg:grid-cols-[280px_1fr]"><aside class="lg:sticky lg:top-6 lg:max-h-[calc(100vh-3rem)] lg:overflow-y-auto lg:pr-2"><h2 class="text-xl">Índice</h2><ol class="mt-4 space-y-2.5 text-sm">{tops.map(t=><li><a class="flex justify-between gap-3 text-slate-600 hover:text-forest" href={`#${t.id}`}><span>{t.label}</span><span class="shrink-0 text-xs text-slate-400">{t.count}</span></a></li>)}</ol></aside>
<section>{groups.map(g=>{const top=g.path[0]??'Disposiciones';const id=slugify(top);const first=!seen.has(id);seen.add(id);return <div class="mb-10">{first&&<h2 id={id} class="scroll-mt-6 border-b border-black/10 pb-3 text-2xl">{top}</h2>}{g.path.length>1&&<p class="mt-4 text-xs font-bold uppercase tracking-wider text-forest">{g.path.slice(1).join(' · ')}</p>}<div class="mt-4 space-y-3">{g.items.map(a=><a class="soft-card block p-5 transition hover:border-forest" href={`${base}normas/${slug}/articulo/${idOf(a)}/`}><b class="text-forest">Artículo {labelOf(a)}</b><p class="mt-2 line-clamp-2 text-slate-600">{snippet(a.texto)}</p></a>)}</div></div>})}</section></div></main></Base>
