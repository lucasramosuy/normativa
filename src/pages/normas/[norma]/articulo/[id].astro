---
import Base from '../../../../layouts/Base.astro';
import {NORMAS,getArticles,getNorma,idOf,labelOf,headingsOf} from '../../../../data/normas';
export function getStaticPaths(){return NORMAS.flatMap(n=>{const list=getArticles(n.slug);return list.map((a,i)=>({params:{norma:n.slug,id:idOf(a)},props:{article:a,prev:list[i-1]??null,next:list[i+1]??null}}))})}
const {article,prev,next}=Astro.props;const slug=Astro.params.norma!;const norma=getNorma(slug);const base=import.meta.env.BASE_URL;
const label=labelOf(article);const path=headingsOf(article);
const derogado=/^\s*\(?derogado/i.test(article.texto);
---
<Base title={`Artículo ${label} · ${norma.corto} · Normativa Uruguay`} description={article.texto.slice(0,155)}><main class="wrap py-10"><nav class="text-sm text-slate-500"><a href={base}>Inicio</a> › <a href={`${base}normas/${slug}/`}>{norma.corto}</a> › Artículo {label}</nav><article class="mx-auto mt-10 max-w-3xl" data-pagefind-body><span class="chip" data-pagefind-ignore>{derogado?'Derogado':'Texto actualizado · IMPO'}</span><p class="eyebrow mt-8" data-pagefind-filter="norma">{norma.corto}</p><h1 class="mt-3 text-6xl" data-pagefind-meta="title">Artículo {label}</h1>{path.length>0&&<p class="mt-3 text-sm text-slate-500">{path.join(' · ')}</p>}<div class="prose-legal mt-10 border-y border-black/10 py-9"><p class="whitespace-pre-line">{article.texto}</p></div>{article.notas_oficiales&&<aside class="mt-8 rounded-xl bg-ivory p-5" data-pagefind-ignore><b>Notas oficiales</b><p class="mt-2 whitespace-pre-line text-sm text-slate-600">{article.notas_oficiales}</p></aside>}<a class="mt-8 flex items-center justify-between rounded-xl border bg-white p-5 font-bold text-forest" href={article.url_fuente} target="_blank" rel="noreferrer" data-pagefind-ignore><span><small class="block font-normal text-slate-500">Fuente oficial</small>{norma.fuente}</span><span>↗</span></a><nav class="mt-8 flex justify-between text-sm font-bold text-forest" data-pagefind-ignore>{prev?<a href={`${base}normas/${slug}/articulo/${idOf(prev)}/`}>← Artículo {labelOf(prev)}</a>:<span/>}{next&&<a href={`${base}normas/${slug}/articulo/${idOf(next)}/`}>Artículo {labelOf(next)} →</a>}</nav></article></main></Base>
