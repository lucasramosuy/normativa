---
import Base from '../../../../layouts/Base.astro';import {articles} from '../../../../data/normas';
export function getStaticPaths(){return articles.map(article=>({params:{numero:String(article.articulo)},props:{article}}))}
const {article}=Astro.props;const base=import.meta.env.BASE_URL;const prev=article.articulo>1?article.articulo-1:null;const next=article.articulo<articles.length?article.articulo+1:null;
---
<Base title={`Artículo ${article.articulo} · Constitución · Normativa Uruguay`} description={article.texto.slice(0,155)}><main class="wrap py-10"><nav class="text-sm text-slate-500"><a href={base}>Inicio</a> › <a href={`${base}normas/constitucion/`}>Constitución</a> › Artículo {article.articulo}</nav><article class="mx-auto mt-10 max-w-3xl"><span class="chip">Vigente</span><p class="eyebrow mt-8">Constitución de la República</p><h1 class="mt-3 text-6xl">Artículo {article.articulo}</h1><p class="mt-3 text-sm text-slate-500">{article.seccion} · {article.capitulo}</p><div class="prose-legal mt-10 border-y border-black/10 py-9"><p>{article.texto}</p></div>{article.notas_oficiales&&<aside class="mt-8 rounded-xl bg-ivory p-5"><b>Notas oficiales</b><p class="mt-2 text-sm text-slate-600">{article.notas_oficiales}</p></aside>}<a class="mt-8 flex items-center justify-between rounded-xl border bg-white p-5 font-bold text-forest" href={article.url_fuente} target="_blank" rel="noreferrer"><span><small class="block font-normal text-slate-500">Fuente oficial</small>IMPO · Constitución 1967</span><span>↗</span></a><nav class="mt-8 flex justify-between text-sm font-bold text-forest">{prev?<a href={`${base}normas/constitucion/articulo/${prev}/`}>← Artículo {prev}</a>:<span/>}{next&&<a href={`${base}normas/constitucion/articulo/${next}/`}>Artículo {next} →</a>}</nav></article></main></Base>
