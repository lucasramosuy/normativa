---
import Base from '../../layouts/Base.astro';
import { openapi } from '../../lib/openapi';
import { NORMAS } from '../../data/normas';
const base = import.meta.env.BASE_URL;
const operations = Object.entries(openapi.paths).map(([path, {get}]) => ({path, ...get}));
---
<Base title="Probá la API · Normativa Uruguay" description="Consultá los endpoints públicos de Normativa desde el navegador, con OpenAPI.">
<main class="wrap api-lab" data-api-lab>
  <a class="back" href={`${base}api/`}>← Documentación de la API</a>
  <div class="lab-heading"><div><p class="eyebrow">Datos abiertos / OpenAPI 3.0</p><h1>Del texto legal<br/>a tu próximo proyecto.</h1><p class="intro">Elegí una consulta. Probala acá. Llevate el JSON.</p></div><a class="spec-link" href={`${base}api/openapi.json`} download="normativa-openapi.json">Descargar OpenAPI ↗</a></div>
  <div class="lab-meta"><span>Solo lectura</span><span>Sin clave</span><span>Sin servicios nuevos</span></div>
  <div class="lab-grid">
    <section class="request-panel" aria-labelledby="consulta-title"><p class="eyebrow">01 / Consulta</p><h2 id="consulta-title">¿Qué necesitás?</h2>
      <form id="api-form"><label for="endpoint">Consulta</label><select id="endpoint" name="endpoint">{operations.map(op => <option value={op.path} selected={op.operationId==='leerArticulo'}>{op.summary}</option>)}</select>
        <p id="endpoint-description">{operations.find(op=>op.operationId==='leerArticulo')?.description}</p>
        <div id="norma-field"><label for="norma">Norma</label><select id="norma" name="norma">{NORMAS.map(n => <option value={n.slug}>{n.corto}</option>)}</select></div>
        <div id="articulo-field"><label for="articulo">ID del artículo</label><input id="articulo" name="articulo" value="7" placeholder="7, 149-bis, 131-144…" required pattern="[a-zA-Z0-9-]+"/><small>El ID sale del índice de cada norma.</small></div>
        <div class="request-url"><span>GET</span><code id="request-path">constitucion/7.json</code></div>
        <button class="run" type="submit" id="run">Probar consulta <span aria-hidden="true">→</span></button>
      </form>
      <p class="source-note">Esta consulta usa los datos publicados de Normativa. No descarga IMPO.</p>
    </section>
    <section class="response-panel" aria-labelledby="respuesta-title"><div class="response-top"><div><p class="eyebrow">02 / Respuesta</p><h2 id="respuesta-title">Los datos, sin vueltas.</h2></div><button id="copy-json" type="button" disabled>Copiar JSON</button></div>
      <p id="status" role="status" aria-live="polite">Todavía no hiciste una consulta.</p>
      <pre id="response" tabindex="0" aria-label="Respuesta JSON"><code>La respuesta aparece acá.

Probar consulta →</code></pre>
      <details class="schema"><summary>Ver el contrato de esta respuesta</summary><pre id="schema" tabindex="0"></pre></details>
      <div class="curl"><div><p class="eyebrow">Llevátela a tu código</p><button id="copy-curl" type="button">Copiar cURL</button></div><pre id="curl" tabindex="0"></pre></div>
    </section>
  </div>
  <p class="legal-note">Fuente: IMPO. Esta API no es una publicación oficial ni certifica la vigencia del texto. <a href={`${base}api/`}>Campos, historial y condiciones →</a></p>
  <noscript><p>Para probar consultas necesitás JavaScript. El <a href={`${base}api/openapi.json`}>archivo OpenAPI</a> y la documentación siguen disponibles.</p></noscript>
</main>
<script>
import { setupApiLab } from '../../lib/api-lab';
setupApiLab();
</script>
<style>
.api-lab{padding-block:2rem 3rem}.back{font-size:.8rem;color:#176b63}.lab-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin:2.2rem 0 1.4rem}h1{font-size:clamp(2.3rem,5vw,3.8rem);line-height:1.08;margin:.65rem 0 1rem;letter-spacing:-.035em}.intro{color:#58625d;font-size:1rem}.spec-link{font-size:.8rem;color:#176b63;font-weight:650;white-space:nowrap;padding-bottom:.5rem}.lab-meta{display:flex;gap:1.5rem;font-size:.73rem;color:#52655d;border-top:1px solid #dedbd3;padding:1rem 0 1.6rem}.lab-meta span:before{content:'•';color:#176b63;margin-right:.5rem}.lab-grid{display:grid;grid-template-columns:minmax(250px,.8fr) minmax(0,1.6fr);border:1px solid #dedbd3;border-radius:1rem;overflow:hidden;background:white}.request-panel{padding:1.8rem;background:#f5f1e8;border-right:1px solid #dedbd3}.response-panel{padding:1.8rem;min-width:0}h2{font-size:1.55rem;margin:.6rem 0 1.6rem;line-height:1.15}label{display:block;font-size:.75rem;font-weight:700;margin:.9rem 0 .4rem}select,input{width:100%;border:1px solid #c4cec7;border-radius:.5rem;background:#fff;padding:.7rem;font:inherit;font-size:.83rem;color:#17211d;min-height:44px}small{display:block;color:#5d6862;font-size:.68rem;margin:.5rem 0}#endpoint-description{font-size:.75rem;line-height:1.6;color:#58625d;min-height:3.6em}.request-url{display:flex;gap:.65rem;border-top:1px solid #dedbd3;margin-top:1.5rem;padding:1rem 0;font-size:.75rem;align-items:baseline}.request-url span{font-weight:750;color:#176b63}.request-url code{overflow-wrap:anywhere;min-width:0}.run{border:0;border-radius:.5rem;padding:.85rem 1rem;background:#176b63;color:#fff;font-weight:700;width:100%;display:flex;justify-content:space-between;cursor:pointer}.run:disabled{opacity:.65;cursor:wait}.source-note{font-size:.7rem;line-height:1.7;color:#58625d;margin:1rem 0 0}.response-top{display:flex;align-items:center;justify-content:space-between;gap:.6rem}.response-top h2{margin-bottom:.7rem}.response-top button,.curl button{font-size:.72rem;color:#176b63;border:1px solid #c6d8d1;border-radius:.4rem;padding:.55rem .7rem;background:white;white-space:nowrap;cursor:pointer;min-height:40px}button:disabled{opacity:.45;cursor:default}#status{font-size:.73rem;color:#53665b;margin:1rem 0}pre{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.75rem;line-height:1.65;overflow:auto;margin:0;max-width:100%;tab-size:2}#response{background:#172b25;color:#dbebe3;border-radius:.6rem;padding:1.1rem;min-height:280px;max-height:430px;white-space:pre-wrap;overflow-wrap:anywhere}.schema{font-size:.73rem;border-bottom:1px solid #e0e4dd;padding:1rem 0;color:#176b63}.schema summary{cursor:pointer}.schema pre{max-height:280px;margin-top:.7rem;white-space:pre-wrap;overflow-wrap:anywhere}.curl{padding-top:1.2rem}.curl>div{display:flex;align-items:center;justify-content:space-between}.curl pre{color:#40564a;padding-top:.6rem;white-space:pre-wrap;overflow-wrap:anywhere}.legal-note{font-size:.73rem;color:#58625d;margin-top:1.2rem;line-height:1.7}.legal-note a{color:#176b63}.eyebrow{margin:0} [hidden]{display:none!important}@media(max-width:700px){.api-lab{padding-top:1.3rem}.lab-heading{display:block;margin-top:1.8rem}.spec-link{display:inline-block;margin-top:.4rem}.lab-meta{gap:.8rem;flex-wrap:wrap}.lab-grid{grid-template-columns:1fr}.request-panel{border-right:0;border-bottom:1px solid #dedbd3;padding:1.2rem}.response-panel{padding:1.2rem}.response-top h2{font-size:1.35rem}.response-top{align-items:start}#response{min-height:240px;max-height:350px}.intro{font-size:.9rem}h2{margin-bottom:1.2rem}}
</style>

</Base>
