---
import Base from '../layouts/Base.astro';import {NORMAS,getArticles,totalArticles,fmt} from '../data/normas';const base=import.meta.env.BASE_URL;
---
<Base title="Explorar normativa · Normativa Uruguay"><main class="wrap py-16"><p class="eyebrow">Colecciones</p><h1 class="mt-3 text-6xl">Explorá la normativa</h1><p class="mt-5 max-w-2xl text-lg text-slate-600">{NORMAS.length} normas y {fmt(totalArticles())} artículos, cada uno con enlace a su texto en IMPO.</p><div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{NORMAS.map((n,i)=><a class={`soft-card p-7 transition hover:border-forest ${i===0?"bg-mint/60":""}`} href={`${base}normas/${n.slug}/`}><span class="chip">{n.tipo}</span><h2 class="mt-10 text-3xl">{n.nombre}</h2><p class="mt-3 text-slate-600">{n.descripcion}</p><b class="mt-6 block text-sm text-forest">{fmt(getArticles(n.slug).length)} artículos →</b></a>)}</div></main></Base>
